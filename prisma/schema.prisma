generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// SQLite does not support enums — all enum-like fields use String with comments.

// ─── EXISTING MODELS (additive changes only, no renames/drops) ───────────────

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  role                String              @default("USER")
  preferences         String?             // JSON string
  mustChangePassword  Boolean             @default(false)  // U2.5: admin-created accounts
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Admin Overhaul Additions
  createdByAdminId    String?
  firstLoginAt        DateTime?
  passwordLoginAllowed Boolean            @default(true)
  emailLoginAllowed   Boolean            @default(true)

  authMethods         UserAuthMethod[]
  notifications       NotificationRecipient[]
  presence            UserPresence?

  watchProgress       WatchProgress[]
  watchlists          Watchlist[]
  ratings             Rating[]
  // U2 relations
  otpChallenges       OtpChallenge[]
  passwordGrants      PasswordChangeGrant[]
  searchHistory       SearchHistory[]
  reviews             Review[]
  reviewReports       ReviewReport[]
  restrictions        UserRestriction[]   @relation("RestrictedUser")
  restrictionsCreated UserRestriction[]   @relation("RestrictionCreator")
  restrictionsRevoked UserRestriction[]   @relation("RestrictionRevoker")
  reviewsMod          Review[]            @relation("ModeratedReviews")
}

model Media {
  id                      String        @id @default(uuid())
  tmdbId                  Int?          @unique
  imdbId                  String?
  title                   String
  originalTitle           String?
  type                    String        // MOVIE or SERIES
  slug                    String        @unique
  overview                String?
  tagline                 String?
  posterPath              String?
  backdropPath            String?
  releaseYear             Int?
  runtime                 Int?
  rating                  Float?
  voteCount               Int?
  genres                  String        // JSON array
  isPublished             Boolean       @default(false)
  isFeatured              Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Admin Overhaul Additions
  liveAt                  DateTime?
  unliveAt                DateTime?
  deletedAt               DateTime?
  sourceKind              String?     // TELEGRAM, UPLOAD, MAGNET
  sourceRef               String?     // JSON
  removedAt               DateTime?
  removedById             String?

  // U2.1: Category, hover banner, ambient palette
  category                String?       // MOVIE | TV_SERIES | ANIME
  hoverBannerKey          String?
  hoverBannerFocal        String?       // JSON: { x, y }
  hoverClipKey            String?
  hoverClipDurationSec    Int?
  hoverTagline            String?       // max 120 chars
  ambientPalette          String?       // JSON: [{ hex, weight }]
  ambientPaletteSource    String        @default("AUTO")  // AUTO | MANUAL
  ambientPaletteUpdatedAt DateTime?

  // U2.G: Denormalized review aggregates
  reviewCount             Int           @default(0)
  reviewAvgRating         Float?

  seasons       Season[]
  torrents      TorrentSource[]
  watchProgress WatchProgress[]
  watchlists    Watchlist[]
  ratings       Rating[]
  reviews       Review[]

  @@index([category, isPublished])
}

model Season {
  id           String    @id @default(uuid())
  mediaId      String
  media        Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  seasonNumber Int
  name         String?
  overview     String?
  posterPath   String?
  airDate      DateTime?

  episodes Episode[]

  @@unique([mediaId, seasonNumber])
}

model Episode {
  id            String    @id @default(uuid())
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber Int
  title         String?
  overview      String?
  stillPath     String?
  airDate       DateTime?
  duration      Int?

  // U2.1: Ambient palette on episode stills
  ambientPalette String?  // JSON: [{ hex, weight }]

  torrents      TorrentSource[]
  watchProgress WatchProgress[]

  @@unique([seasonId, episodeNumber])
}

model TorrentSource {
  id            String   @id @default(uuid())
  mediaId       String?
  media         Media?   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episodeId     String?
  episode       Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title         String
  magnetUri     String
  infoHash      String
  fileIndex     Int
  resolution    String
  codec         String?
  container     String?
  sizeInBytes   BigInt?
  seeders       Int      @default(0)
  leechers      Int      @default(0)
  lastCheckedAt DateTime?

  @@index([infoHash])
}

model WatchProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episodeId   String?
  episode     Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  timestampSec Int     @default(0)
  isCompleted  Boolean @default(false)
  updatedAt   DateTime @updatedAt

  // U2.3: Continue Watching management
  hiddenFromContinue Boolean   @default(false)
  hiddenAt           DateTime?
  watchedAt          DateTime? // set when isCompleted becomes true

  @@unique([userId, mediaId, episodeId])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  // U2.3: Manual ordering
  sortOrder Int?

  @@unique([userId, mediaId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaId])
}

// ─── U2.4 SEARCH HISTORY ─────────────────────────────────────────────────────

model SearchHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  queryNormalized String   // lowercased, trimmed, collapsed spaces
  queryDisplay    String   // as typed, max 80 chars
  count           Int      @default(1)
  createdAt       DateTime @default(now())
  lastSearchedAt  DateTime @default(now())

  @@unique([userId, queryNormalized])
  @@index([userId, lastSearchedAt])
}

// ─── U2.5 PASSWORD CHANGE OTP ────────────────────────────────────────────────

model OtpChallenge {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String    // PASSWORD_CHANGE
  codeHash    String
  salt        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  lastSentAt  DateTime  @default(now())
  sendCount   Int       @default(1)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

model PasswordChangeGrant {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── U2.6 REVIEWS ────────────────────────────────────────────────────────────

model Review {
  id               String    @id @default(uuid())
  mediaId          String
  media            Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating           Int       // 1–5
  body             String    // 10–1500 chars
  containsSpoilers Boolean   @default(false)
  status           String    @default("VISIBLE") // VISIBLE | HIDDEN | REMOVED
  isEditorial      Boolean   @default(false)
  authorLabel      String?   // e.g. "Editor's pick"
  isPinned         Boolean   @default(false)
  editedAt         DateTime?
  moderatedById    String?
  moderatedBy      User?     @relation("ModeratedReviews", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reports ReviewReport[]

  @@unique([mediaId, userId])  // one user review per title; editorial has userId null
  @@index([mediaId, status, createdAt])
  @@index([userId])
}

model ReviewReport {
  id             String   @id @default(uuid())
  reviewId       String
  review         Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  reason         String   // SPAM | ABUSE | SPOILER | OFF_TOPIC | OTHER
  details        String?
  status         String   @default("OPEN") // OPEN | RESOLVED | REJECTED
  handledById    String?
  createdAt      DateTime @default(now())

  @@unique([reviewId, reporterUserId])
}

// ─── U2.7 USER RESTRICTIONS ──────────────────────────────────────────────────

model UserRestriction {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  type         String    // WATCH_BLOCK | REVIEW_BLOCK | LOGIN | WATCH | REVIEW
  reason       String    // required, shown to user
  expiresAt    DateTime? // null = permanent
  createdById  String
  createdBy    User      @relation("RestrictionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("RestrictionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeNote   String?
  internalNote String?

  @@index([userId, type, revokedAt, expiresAt])
}

// ─── U2.8 DELETED USER TOMBSTONE ─────────────────────────────────────────────

model DeletedUserTombstone {
  id          String   @id @default(uuid())
  userIdHash  String   // SHA-256 of userId + server pepper
  emailHash   String   // SHA-256 of lowercased email + server pepper
  deletedAt   DateTime @default(now())
  deletedById String?
  reason      String?

  @@index([emailHash])
}


// ─── ADMIN OVERHAUL MODELS ────────────────────────────────────────

model MediaActivity {
  id              String   @id @default(uuid())
  titleId         String?  // survives hard delete
  titleSnapshot   String   // JSON
  action          String   // CREATED, MODIFIED, REMOVED, RESTORED, WENT_LIVE, WENT_UNLIVE, SOURCE_CHANGED
  changes         String   // JSON array
  actorId         String
  requestId       String?
  createdAt       DateTime @default(now())

  @@index([titleId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model AdminAlert {
  id              String   @id @default(uuid())
  category        String   // MEDIA, TORRENT, USER, ACCESS, NOTIFICATION, SETTINGS, SYSTEM
  severity        String   // INFO, SUCCESS, WARNING, CRITICAL
  title           String
  body            String
  entityType      String
  entityId        String
  actorId         String?
  dedupeKey       String?
  count           Int      @default(1)
  meta            String?  // JSON
  createdAt       DateTime @default(now())
  lastOccurredAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([dedupeKey, lastOccurredAt(sort: Desc)])
}

model AdminAlertRead {
  alertId         String
  adminId         String
  readAt          DateTime @default(now())

  @@unique([alertId, adminId])
}

model AdminAlertPref {
  id              String   @id @default(uuid())
  adminId         String
  category        String
  inApp           Boolean  @default(true)
  desktop         Boolean  @default(false)
  sound           Boolean  @default(false)

  @@unique([adminId, category])
}

model Notification {
  id              String   @id @default(uuid())
  kind            String   // BROADCAST, SYSTEM, FIRST_LOGIN_NOTICE, RESTRICTION, MEDIA
  title           String   // max 80
  body            String   // max 500
  linkUrl         String?
  audience        String   // ALL, USER, USERS
  createdById     String?
  scheduledFor    DateTime?
  expiresAt       DateTime?
  recalledAt      DateTime?
  createdAt       DateTime @default(now())

  recipients      NotificationRecipient[]
}

model NotificationRecipient {
  id              String   @id @default(uuid())
  notificationId  String
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt     DateTime?
  readAt          DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

model UserPresence {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state                String   // ONLINE, AWAY, OFFLINE
  lastHeartbeatAt      DateTime
  lastSeenAt           DateTime
  currentMediaAssetId  String?
  currentTitleId       String?
  currentEpisodeId     String?
  currentPositionSec   Int?
  currentSource        String?  // HEARTBEAT, PLAYBACK
  deviceLabel          String?
  updatedAt            DateTime @updatedAt
}

model TorrentHealthSample {
  id              String   @id @default(uuid())
  torrentId       String
  ts              DateTime @default(now())
  resolution      String   // FINE_30S, COARSE_5M
  seeders         Int
  leechers        Int
  peersTotal      Int
  downloadBps     BigInt
  uploadBps       BigInt
  availability    Float
  progress        Float
  viewers         Int
  healthScore     Int

  @@index([torrentId, resolution, ts(sort: Desc)])
}

model TelegramPost {
  id              String   @id @default(uuid())
  chatId          String
  messageId       Int
  postedAt        DateTime
  kind            String   // TORRENT_FILE, MAGNET, VIDEO, OTHER
  text            String?
  caption         String?
  fileId          String?
  fileUniqueId    String?
  fileName        String?
  mimeType        String?
  sizeBytes       BigInt?
  magnets         String?  // JSON array
  hashtags        String?  // JSON array
  editedAt        DateTime?
  removedAt       DateTime?
  indexedAt       DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([chatId, messageId(sort: Desc)])
  @@index([kind, postedAt(sort: Desc)])
}

model UserAuthMethod {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   // OAUTH_EMAIL, OWN_PASSWORD
  provider          String?
  providerAccountId String?
  email             String?
  passwordHash      String?
  linkedAt          DateTime @default(now())
  lastUsedAt        DateTime?
  disabledAt        DateTime?

  @@unique([provider, providerAccountId])
}

model AdminEventLog {
  id        BigInt   @id @default(autoincrement())
  type      String
  payload   String   // JSON
  createdAt DateTime @default(now())
}

model DashboardMetricSample {
  id        String   @id @default(uuid())
  key       String
  ts        DateTime @default(now())
  value     Int

  @@index([key, ts(sort: Desc)])
}
