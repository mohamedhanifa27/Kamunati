{
  "name": "torrent-stream-engine",
  "version": "1.0.0",
  "description": "Production-Grade Sequential Torrent Streaming Engine & Media Proxy",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:engine": "tsc -p tsconfig.server.json",
    "build:ui": "next build",
    "start:engine": "node dist/server.js",
    "start:ui": "next start",
    "start": "concurrently \"npm run start:engine\" \"npm run start:ui\" \"npm run telegram-bot\"",
    "dev:engine": "ts-node --transpile-only src/server.ts",
    "dev:ui": "next dev",
    "dev": "concurrently \"npm run dev:engine\" \"npm run dev:ui\" \"npm run telegram-bot\"",
    "telegram-bot": "ts-node telegram/bot.ts"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^9.0.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.49.0",
    "mime-types": "^2.1.35",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-view-transitions": "^0.3.5",
    "node-telegram-bot-api": "^2.1.0",
    "parse-torrent": "^5.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.89.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "three128": "npm:three@^0.128.0",
    "torrent-stream": "^1.2.1",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.12.7",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/react": "19.3.0",
    "@types/torrent-stream": "^0.0.9",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
